<!doctype html>
<html lang="pt">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Painel da Equipa PCE</title>
<style>
:root{--bg:#f4f5f7;--card:#fff;--txt:#1f2937;--muted:#6b7280;--line:#e5e7eb;--acc:#1e3a5f}
@media (prefers-color-scheme:dark){:root{--bg:#111418;--card:#1b1f25;--txt:#e5e7eb;--muted:#9ca3af;--line:#2d333b;--acc:#93c5fd}}
*{box-sizing:border-box}
body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--txt);line-height:1.45}
.wrap{max-width:960px;margin:0 auto;padding:24px 16px 60px}
header h1{margin:0 0 4px;font-size:1.6rem;color:var(--acc)}
header p{margin:0;color:var(--muted)}
#login{max-width:360px;margin:15vh auto 0;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:28px}
#login h1{margin:0 0 6px;font-size:1.35rem;color:var(--acc)}
#login p{margin:0 0 18px;color:var(--muted);font-size:.95rem}
input{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:9px;font-size:1rem;background:var(--bg);color:var(--txt)}
button{cursor:pointer;font:inherit}
.btn{width:100%;margin-top:12px;padding:11px;border:0;border-radius:9px;background:var(--acc);color:#fff;font-weight:600}
@media (prefers-color-scheme:dark){.btn{color:#111418}}
#erro{color:#dc2626;font-size:.9rem;min-height:1.2em;margin-top:8px}
.bar{display:flex;gap:10px;margin:20px 0 8px;flex-wrap:wrap}
.bar input{flex:1;min-width:200px}
.sair{padding:10px 14px;border:1px solid var(--line);border-radius:9px;background:var(--card);color:var(--txt)}
section{margin-top:26px}
section h2{font-size:1.1rem;margin:0 0 10px;padding-left:10px;border-left:5px solid var(--c)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px;display:flex;flex-direction:column;gap:8px}
.card a.nome{font-weight:600;color:var(--txt);text-decoration:none}
.card a.nome:hover{color:var(--c);text-decoration:underline}
.nota{font-size:.88rem;color:var(--muted)}
.cred{font-size:.88rem;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.cred span.l{color:var(--muted)}
code{background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:2px 6px;font-size:.88rem;word-break:break-all}
.cp{border:1px solid var(--line);background:transparent;color:var(--muted);border-radius:6px;padding:1px 7px;font-size:.78rem}
.cp.ok{color:#059669;border-color:#059669}
.abrir{align-self:flex-start;font-size:.85rem;color:var(--c);text-decoration:none;font-weight:600}
.hide{display:none!important}
</style>
</head>
<body>
<div id="login">
  <h1>Painel da Equipa PCE</h1>
  <p>Agrupamento de Escolas Templários de Tomar — introduz a palavra-passe da equipa.</p>
  <form id="f"><input id="pw" type="password" placeholder="Palavra-passe" autocomplete="current-password" autofocus>
  <button class="btn" type="submit">Entrar</button></form>
  <div id="erro"></div>
</div>

<div id="app" class="wrap hide">
  <header><h1>Painel da Equipa PCE</h1><p>Links, folhas de dados e palavras-passe das aplicações.</p></header>
  <div class="bar"><input id="q" placeholder="Pesquisar (ex.: inscrições, sheets, CAA)…"><button class="sair" id="sair">Sair</button></div>
  <div id="conteudo"></div>
</div>

<script>
const CIFRA = "qz2AfAri/KjNc+G6xatheg==.gs9NQLe9o81ZksXJ.";
const b64 = s => Uint8Array.from(atob(s), c => c.charCodeAt(0));
async function decifrar(pw){
  const [salt, iv, ct] = CIFRA.split(".").map(b64);
  const base = await crypto.subtle.importKey("raw", new TextEncoder().encode(pw), "PBKDF2", false, ["deriveKey"]);
  const key = await crypto.subtle.deriveKey({name:"PBKDF2", salt, iterations:200000, hash:"SHA-256"}, base, {name:"AES-GCM", length:256}, false, ["decrypt"]);
  const pt = await crypto.subtle.decrypt({name:"AES-GCM", iv}, key, ct);
  return JSON.parse(new TextDecoder().decode(pt));
}
const esc = s => String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const credLinha = (rot, val) => `<div class="cred"><span class="l">${esc(rot)}:</span><code>${esc(val)}</code><button class="cp" data-v="${esc(val)}">copiar</button></div>`;

function render(d){
  let h = `<section style="--c:#475569"><h2>Contas Google / e-mail</h2><div class="grid">`;
  d.contas.forEach(c => {
    h += `<div class="card" data-s="${esc((c.nome+" "+c.user+" "+c.nota).toLowerCase())}"><strong>${esc(c.nome)}</strong>`
      + credLinha("Conta", c.user) + (c.pw ? credLinha("Palavra-passe", c.pw) : "")
      + (c.nota ? `<div class="nota">${esc(c.nota)}</div>` : "") + `</div>`;
  });
  h += `</div></section>`;
  d.projetos.forEach(p => {
    h += `<section style="--c:${esc(p.cor)}"><h2>${esc(p.titulo)}</h2><div class="grid">`;
    p.itens.forEach(i => {
      h += `<div class="card" data-s="${esc((p.titulo+" "+i.nome+" "+(i.nota||"")).toLowerCase())}">`
        + `<a class="nome" href="${esc(i.url)}" target="_blank" rel="noopener">${esc(i.nome)}</a>`
        + (i.nota ? `<div class="nota">${esc(i.nota)}</div>` : "")
        + (i.conta ? credLinha("Conta", i.conta) : "")
        + (i.pw ? credLinha("Palavra-passe", i.pw) : "")
        + (i.senhas||[]).map(s => credLinha("Senha " + s[0], s[1])).join("")
        + `<a class="abrir" href="${esc(i.url)}" target="_blank" rel="noopener">Abrir ↗</a></div>`;
    });
    h += `</div></section>`;
  });
  document.getElementById("conteudo").innerHTML = h;
}

function mostrar(d){
  render(d);
  document.getElementById("login").classList.add("hide");
  document.getElementById("app").classList.remove("hide");
}

document.getElementById("f").addEventListener("submit", async e => {
  e.preventDefault();
  const pw = document.getElementById("pw").value;
  try { const d = await decifrar(pw); try{sessionStorage.setItem("pce_pw", pw)}catch(_){}; mostrar(d); }
  catch(_) { document.getElementById("erro").textContent = "Palavra-passe incorreta."; }
});
document.getElementById("sair").onclick = () => { try{sessionStorage.removeItem("pce_pw")}catch(_){}; location.reload(); };
document.getElementById("q").addEventListener("input", e => {
  const q = e.target.value.toLowerCase().trim();
  document.querySelectorAll(".card").forEach(c => c.classList.toggle("hide", q && !c.dataset.s.includes(q)));
  document.querySelectorAll("section").forEach(s => s.classList.toggle("hide", !s.querySelector(".card:not(.hide)")));
});
document.addEventListener("click", e => {
  const b = e.target.closest(".cp"); if(!b) return;
  navigator.clipboard.writeText(b.dataset.v).then(() => { b.textContent="copiado"; b.classList.add("ok"); setTimeout(()=>{b.textContent="copiar"; b.classList.remove("ok")},1500); });
});
(async () => { let pw=null; try{pw=sessionStorage.getItem("pce_pw")}catch(_){}; if(pw){ try{ mostrar(await decifrar(pw)); }catch(_){} } })();
</script>
</body>
</html>
